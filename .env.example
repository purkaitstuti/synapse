# --- AI (optional: without a key Synapse runs in Offline mode) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# --- Databases (optional: SQLite + in-memory graph are used when empty) ---
DATABASE_URL=sqlite:///./synapse.db
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
CHROMA_PATH=./.chroma
# --- Research APIs ---
OPENALEX_API_KEY=you@example.com
SEMANTIC_SCHOLAR_API_KEY=
# --- App ---
CORS_ORIGINS=http://localhost:5173
# Optional: models to try if the main one keeps returning 503/404 (comma-separated)
GEMINI_FALLBACK_MODELS=
